# Port de l'API
PORT=5002

# Adresse du frontend Vite (pour CORS)
CLIENT_URL=http://localhost:5173

# Connexion MySQL (XAMPP : utilisateur root, mot de passe vide par défaut)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=noziwild

# Jeton secret pour lire les données (routes /api/admin/*)
# Remplace-le par une longue chaîne aléatoire
ADMIN_TOKEN=change-moi

# Secret pour signer les sessions (JWT). Longue chaîne aléatoire, à garder privée.
JWT_SECRET=change-moi

# Durée d'une session
SESSION_DAYS=7

# true en production (HTTPS), false en local
COOKIE_SECURE=false

# Identifiant client OAuth Google (console.cloud.google.com > API et services > Identifiants)
GOOGLE_CLIENT_ID=

# Envoi des emails "mot de passe oublié".
# Laisser SMTP_HOST vide en local : le lien s'affiche alors dans la console du serveur.
# Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=ton.adresse@gmail.com,
# SMTP_PASS=mot de passe d'application (compte Google > Sécurité > Mots de passe des applications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Noziwild <no-reply@noziwild.com>"
